---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import Card from "../../components/Card/index.astro";
import { SITE } from "../../site-config";

const projects = [
  {
    title: "Rive rifle animation",
    titleKey: "playground.projects.rifleTitle",
    description: "Interactive rifle animation made in rive.app",
    descriptionKey: "playground.projects.rifleDescription",
    slug: "/rifle-1",
    tags: ["Rive"],
    date: "2026-04-03",
  },
  {
    title: "GSAP future svg Scroll experiment",
    titleKey: "playground.projects.futureTitle",
    description:
      "Scroll animation made with GSAP and some custom futuristic svg",
    descriptionKey: "playground.projects.futureDescription",
    slug: "/future-scroll",
    tags: ["GSAP", "SVG"],
    date: "2026-04-03",
  },
  {
    title: "Glowing stars text",
    titleKey: "playground.projects.starsTitle",
    description: "Glowing stars text, inspired by the nextjs website",
    descriptionKey: "playground.projects.starsDescription",
    slug: "/glowing-stars",
    tags: ["SolidJS", "Canvas"],
    date: "2026-04-03",
  },
  {
    title: "Turbulence clip-path header",
    titleKey: "playground.projects.turbulenceTitle",
    description: "Header animation made clip-path and turbulence svg filter",
    descriptionKey: "playground.projects.turbulenceDescription",
    slug: "/turbulence-header",
    tags: ["SVG", "CSS"],
    date: "2026-04-03",
  },
  {
    title: "Fancy card carousel",
    titleKey: "playground.projects.carouselTitle",
    description: "Fancy carousel with league of legends champions",
    descriptionKey: "playground.projects.carouselDescription",
    slug: "/carousel",
    tags: ["SolidJS", "Motion"],
    date: "2026-04-03",
  },
  {
    title: "Sliding images loader",
    titleKey: "playground.projects.slidingTitle",
    description:
      "Loader animation inspired by camillemormal.com, built with SolidJS and Motion One",
    descriptionKey: "playground.projects.slidingDescription",
    slug: "/sliding-images-loader",
    tags: ["SolidJS", "Motion"],
    date: "2026-04-03",
  },
  {
    title: "Wireframe globe",
    titleKey: "playground.projects.globeTitle",
    description:
      "Rotating canvas wireframe sphere with latitude and longitude lines",
    descriptionKey: "playground.projects.globeDescription",
    slug: "/wireframe-globe",
    tags: ["Canvas", "SolidJS"],
    date: "2026-04-03",
  },
  {
    title: "Morph & pixel wipe",
    titleKey: "playground.projects.wipeTitle",
    description: "SVG morph wipes or a staggered pixel-grid cover/reveal",
    descriptionKey: "playground.projects.wipeDescription",
    slug: "/morph-wipe",
    tags: ["GSAP", "SVG"],
    date: "2026-04-16",
  },
  {
    title: "Fanned cards",
    titleKey: "playground.projects.fannedTitle",
    description:
      "Three fanned cards with the middle one zooming in and settling on load",
    descriptionKey: "playground.projects.fannedDescription",
    slug: "/fanned-cards",
    tags: ["SolidJS", "Motion"],
    date: "2026-08-01",
  },
  {
    title: "Nine-slice frame",
    titleKey: "playground.projects.nineTitle",
    description:
      "The fanned-card frame as a resizable container — corners stay exact at any size",
    descriptionKey: "playground.projects.nineDescription",
    slug: "/nine-slice",
    tags: ["SVG", "CSS"],
    date: "2026-08-04",
  },
  {
    title: "Avatar turntable",
    titleKey: "playground.projects.turntableTitle",
    description:
      "My 3D avatar rendered in Blender as 24 frames, looped as a stepped CSS spritesheet",
    descriptionKey: "playground.projects.turntableDescription",
    slug: "/avatar-turntable",
    tags: ["Blender", "CSS"],
    date: "2026-08-08",
  },
  {
    title: "Avatar scroll",
    titleKey: "playground.projects.avatarScrollTitle",
    description:
      "The Blender avatar as a Three.js glass shader, walked from the right edge to centre",
    descriptionKey: "playground.projects.avatarScrollDescription",
    slug: "/avatar-scroll",
    tags: ["Blender", "Three.js"],
    date: "2026-08-09",
  },
  {
    title: "Dither lab",
    titleKey: "playground.projects.ditherTitle",
    description:
      "Live palette and Bayer tuning for the dithered avatar, sharing the batch script's dither code",
    descriptionKey: "playground.projects.ditherDescription",
    slug: "/dither-lab",
    tags: ["Canvas", "Tweakpane"],
    date: "2026-08-08",
  },
];

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });

export const prerender = true;
---

<Layout
  title={`${SITE.author.fullName} - Playground`}
  description="A collection of experiments and creative explorations with different technologies."
  titleBn={`${SITE.author.fullName} - পরীক্ষামূলক কাজ`}
  descriptionBn="বিভিন্ন প্রযুক্তি নিয়ে আমার পরীক্ষা ও সৃজনশীল কাজের সংগ্রহ।"
>
  <main
    class="w-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8 text-white"
  >
    <BackLink href="/" class="mb-8" />
    <h1 class="text-4xl font-bold mb-4 text-neutral-100" data-i18n="playground.title">Playground</h1>
    <div class="grid grid-cols-2 gap-4 w-full">
      {
        projects.map((project, i) => (
          <Card
            href={`/playground${project.slug}`}
            height="h-auto"
            colSpan="col-span-2 md:col-span-1"
            arrowCorner={true}
          >
            <div class="flex flex-col gap-3 h-full">
              <span class="text-3xs font-medium tabular-nums text-darkslate-400 tracking-widest">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h2 class="font-semibold text-lg leading-snug text-darkslate-50 break-words" data-i18n={project.titleKey}>
                  {project.title}
                </h2>
                <p class="text-darkslate-300 text-sm mt-1" data-i18n={project.descriptionKey}>
                  {project.description}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 mt-auto pt-1">
                {project.tags.map((tag) => (
                  <span class="text-3xs font-medium px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-300">
                    {tag}
                  </span>
                ))}
                <span class="ml-auto text-3xs font-medium tabular-nums text-darkslate-400 tracking-widest" data-date={project.date}>
                  {formatDate(project.date)}
                </span>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </main>
</Layout>
