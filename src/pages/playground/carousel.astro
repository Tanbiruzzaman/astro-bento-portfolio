---
import PlaygroundShell from "../../components/PlaygroundShell.astro";
import CarouselComponent from "../../components/playground/carousel";
import { SITE } from "../../site-config";

export const prerender = true;
---

<PlaygroundShell
  title={`${SITE.author.fullName} - Playground - Fancy league of legends carousel`}
  titleBn={`${SITE.author.fullName} - League of Legends কার্ড ক্যারোসেল`}
  descriptionBn="League of Legends চরিত্রদের নিয়ে ইন্টারঅ্যাকটিভ কার্ড ক্যারোসেল।"
  description="Fancy carousel with league of legends champions"
>
  <CarouselComponent client:load />
</PlaygroundShell>
