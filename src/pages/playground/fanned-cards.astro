---
import PlaygroundShell from "../../components/PlaygroundShell.astro";
import FannedCards from "../../components/playground/fannedCards";
import { SITE } from "../../site-config";

export const prerender = true;
---

<PlaygroundShell
  title={`${SITE.author.fullName} - Playground - Fanned cards`}
  titleBn={`${SITE.author.fullName} - পাখার মতো কার্ড`}
  descriptionBn="মাঝের কার্ডটি বড় হয়ে ওঠে—এমন অ্যানিমেটেড কার্ড বিন্যাস।"
  description="Three fanned cards with the middle one zooming in on load"
>
  <FannedCards client:load />
</PlaygroundShell>
