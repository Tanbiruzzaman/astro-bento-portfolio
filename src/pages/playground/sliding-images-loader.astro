---
import PlaygroundShell from "../../components/PlaygroundShell.astro";
import SlidingImagesLoaderComponent from "../../components/playground/slidingImgesLoader";
import { SITE } from "../../site-config";

export const prerender = true;
---

<PlaygroundShell
  title={`${SITE.author.fullName} - Playground - Sliding images loader`}
  titleBn={`${SITE.author.fullName} - স্লাইডিং ছবি লোডার`}
  descriptionBn="স্লাইডিং ছবির মাধ্যমে তৈরি লোডার অ্যানিমেশন।"
  description="Cool sliding images initial loader"
  floatingBack
>
  <SlidingImagesLoaderComponent client:load />
</PlaygroundShell>
