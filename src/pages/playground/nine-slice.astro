---
import PlaygroundShell from "../../components/PlaygroundShell.astro";
import NineSliceFrame from "../../components/NineSliceFrame.astro";
import { nineSliceDataUri } from "../../lib/nine-slice";
import { SITE } from "../../site-config";

const naiveImage = nineSliceDataUri();

export const prerender = true;
---

<PlaygroundShell
  title={`${SITE.author.fullName} - Playground - Nine-slice frame`}
  titleBn={`${SITE.author.fullName} - নাইন-স্লাইস ফ্রেম`}
  descriptionBn="যেকোনো আকারে কোণা অক্ষত রেখে প্রসারিত করা যায় এমন ফ্রেম।"
  description="The fanned-card frame rebuilt as a resizable nine-slice container"
>
  <div class="ns-stage" id="ns-stage">
    <figure class="ns-figure">
      <figcaption class="ns-label" data-i18n="playground.nineSlice">Nine-slice</figcaption>
      <NineSliceFrame class="ns-box" padding="2rem">
        <div class="ns-copy">
          <h1 data-i18n="playground.nineSlice">Nine-slice</h1>
          <p data-i18n="playground.nineBody">
            Corners are pinned and never resampled. Only the straight rails
            between them stretch — which is lossless, because they are straight
            lines.
          </p>
          <p class="ns-dims"><span id="ns-readout">420 &times; 320</span></p>
        </div>
      </NineSliceFrame>
    </figure>

    <figure class="ns-figure" id="ns-compare" hidden>
      <figcaption class="ns-label ns-label--warn" data-i18n="playground.naiveStretch">Naive stretch</figcaption>
      <div class="ns-box ns-naive" style={`--ns-naive-image:${naiveImage};`}>
        <div class="ns-copy">
          <h1 data-i18n="playground.naiveStretch">Naive stretch</h1>
          <p data-i18n="playground.nineNaiveBody">
            The same SVG scaled to fill the box. The corner motifs smear and the
            rail thickness drifts.
          </p>
        </div>
      </div>
    </figure>
  </div>
</PlaygroundShell>

<style>
  .ns-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;

    --w: 420px;
    --h: 320px;
  }

  .ns-figure {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .ns-figure[hidden] {
    display: none;
  }

  .ns-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--darkslate-300);
  }

  .ns-label--warn {
    color: var(--primary-500);
  }

  .ns-stage :global(.ns-box) {
    width: var(--w);
    height: var(--h);
  }

  .ns-naive {
    position: relative;
    background-image: var(--ns-naive-image);
    background-size: 100% 100%;
    background-repeat: no-repeat;
    padding: 2rem;
  }

  .ns-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    overflow: hidden;
    color: var(--darkslate-100);
  }

  .ns-copy h1 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .ns-copy p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--darkslate-300);
    margin: 0;
  }

  .ns-dims {
    margin-top: auto !important;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .ns-stage.show-pad :global(.nine-slice__content)::after,
  .ns-stage.show-pad .ns-naive::after {
    content: "";
    position: absolute;
    inset: 0;
    border: var(--ns-pad, 2rem) solid
      color-mix(in srgb, var(--primary-500) 40%, transparent);
    pointer-events: none;
  }
</style>

<script>
  import { Pane } from "tweakpane";
  import { getLang, t } from "../../i18n";
  import {
    nineSliceGeometry,
    nineSliceVars,
    NINE_SLICE_BORDER,
    NINE_SLICE_FILL,
    NINE_SLICE_STROKE,
  } from "../../lib/nine-slice";

  const PARAMS = {
    width: 420,
    height: 320,
    borderWidth: NINE_SLICE_BORDER,
    padding: 32,
    fill: NINE_SLICE_FILL,
    stroke: NINE_SLICE_STROKE,
    showPadding: false,
    compare: false,
  };

  let pane: Pane | null = null;

  function initNineSlice() {
    const stage = document.getElementById("ns-stage");
    const compare = document.getElementById("ns-compare");
    const readout = document.getElementById("ns-readout");
    const frame = stage?.querySelector<HTMLElement>(".nine-slice");
    const naive = stage?.querySelector<HTMLElement>(".ns-naive");
    if (!stage || !compare || !readout || !frame || !naive) return;

    const applySize = () => {
      const { min } = nineSliceGeometry(PARAMS.borderWidth);
      const clamped = PARAMS.width < min || PARAMS.height < min;
      PARAMS.width = Math.max(PARAMS.width, min);
      PARAMS.height = Math.max(PARAMS.height, min);
      stage.style.setProperty("--w", `${PARAMS.width}px`);
      stage.style.setProperty("--h", `${PARAMS.height}px`);
      const format = (value: number) => new Intl.NumberFormat(getLang() === "bn" ? "bn-BD" : "en-US").format(value);
      readout.textContent = `${format(PARAMS.width)} × ${format(PARAMS.height)}  ·  ${t("playground.min", getLang()).replace("{min}", format(min))}`;
      if (clamped) pane?.refresh();
    };

    const applyImage = () => {
      const options = {
        fill: PARAMS.fill,
        stroke: PARAMS.stroke,
        borderWidth: PARAMS.borderWidth,
      };
      const vars = nineSliceVars(options);
      Object.entries(vars).forEach(([k, v]) => frame.style.setProperty(k, v));
      naive.style.setProperty("--ns-naive-image", vars["--ns-image"]);
    };

    const applyPadding = () => {
      frame.style.setProperty("--ns-pad", `${PARAMS.padding}px`);
      naive.style.setProperty("--ns-pad", `${PARAMS.padding}px`);
      naive.style.padding = `${PARAMS.padding}px`;
    };

    applySize();
    applyImage();
    applyPadding();

    function buildPane() {
      pane?.dispose();
      const lang = getLang();
      pane = new Pane({ title: t("playground.nineSlicePane", lang) });

    pane
      .addBinding(PARAMS, "width", { label: t("playground.width", lang), min: 180, max: 900, step: 1 })
      .on("change", applySize);
    pane
      .addBinding(PARAMS, "height", { label: t("playground.height", lang), min: 180, max: 700, step: 1 })
      .on("change", applySize);
    pane
      .addBinding(PARAMS, "borderWidth", { label: t("playground.borderWidth", lang), min: 0, max: 40, step: 0.5 })
      .on("change", () => {
        applyImage();
        applySize();
      });
    pane
      .addBinding(PARAMS, "padding", { label: t("playground.padding", lang), min: 0, max: 120, step: 1 })
      .on("change", applyPadding);
    pane.addBinding(PARAMS, "fill", { label: t("playground.fill", lang), view: "color" }).on("change", applyImage);
    pane
      .addBinding(PARAMS, "stroke", { label: t("playground.stroke", lang), view: "color" })
      .on("change", applyImage);
    pane.addBinding(PARAMS, "showPadding", { label: t("playground.showPadding", lang) }).on("change", () => {
      stage?.classList.toggle("show-pad", PARAMS.showPadding);
    });
    pane.addBinding(PARAMS, "compare", { label: t("playground.compare", lang) }).on("change", () => {
      if (compare) compare.hidden = !PARAMS.compare;
    });
    }
    buildPane();
    languageChangeHandler = () => {
      buildPane();
      applySize();
    };
    document.addEventListener("languagechange", languageChangeHandler);
  }

  let languageChangeHandler: (() => void) | null = null;
  function disposeNineSlice() {
    if (languageChangeHandler) document.removeEventListener("languagechange", languageChangeHandler);
    languageChangeHandler = null;
    pane?.dispose();
    pane = null;
  }

  document.addEventListener("astro:page-load", initNineSlice);
  document.addEventListener("astro:before-swap", disposeNineSlice);
</script>
