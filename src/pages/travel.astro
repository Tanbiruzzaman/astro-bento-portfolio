---
import Globe from "../components/Globe";
import BackLink from "../components/BackLink.astro";
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";

export const prerender = true;
---

<BasicLayout
  description="A 3d globe showing countries that you have visited so far"
  page="travel"
  title={`${SITE.author.fullName} - Visited Countries`}
  titleBn={`${SITE.author.fullName} - ভ্রমণ করা দেশ`}
  descriptionBn="আমি যেসব দেশ ভ্রমণ করেছি, সেগুলো গ্লোব থেকে দেখুন।"
>
  <BackLink href="/" class="absolute top-4 left-4" />

  <Globe client:load enableHover={true} />
</BasicLayout>
