---
import Layout from "../layouts/Layout.astro";
import BackLink from "./BackLink.astro";

interface Props {
  title: string;
  description: string;
  titleBn?: string;
  descriptionBn?: string;
  scrollable?: boolean;
  floatingBack?: boolean;
}

const {
  title,
  description,
  titleBn,
  descriptionBn,
  scrollable = false,
  floatingBack = false,
} = Astro.props;

const heightClass = scrollable ? "min-h-screen" : "h-screen";
---

<Layout title={title} description={description} titleBn={titleBn} descriptionBn={descriptionBn}>
  <div
    class:list={[
      "relative flex flex-col w-full p-4 overscroll-none",
      heightClass,
    ]}
  >
    {
      floatingBack ? (
        <BackLink class="absolute left-4 top-4 z-20" />
      ) : (
        <BackLink />
      )
    }
    <div class="flex-1 w-full flex justify-center items-center overflow-hidden">
      <slot />
    </div>
  </div>
</Layout>
