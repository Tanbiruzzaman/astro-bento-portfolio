---
import BasicLayout from "./BasicLayout.astro";

interface Props {
  title: string;
  description: string;
  hideSoundToggle?: boolean;
  noindex?: boolean;
  titleBn?: string;
  descriptionBn?: string;
}

const { title, description, hideSoundToggle, noindex, titleBn, descriptionBn } = Astro.props;
---

<BasicLayout
  description={description}
  title={title}
  hideSoundToggle={hideSoundToggle}
  noindex={noindex}
  titleBn={titleBn}
  descriptionBn={descriptionBn}
>
  <slot />
</BasicLayout>
